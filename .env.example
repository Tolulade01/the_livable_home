# Copy this file to .env.local and fill in real values before connecting
# the newsletter form, contact form, or analytics.

# Site
NEXT_PUBLIC_SITE_URL=https://thelivablehome.vercel.app

# Newsletter (MailerLite example — swap for ConvertKit if preferred)
MAILERLITE_API_KEY=
MAILERLITE_GROUP_ID=

# Contact form (if wiring to Resend, Postmark, or similar)
CONTACT_FORM_API_KEY=
CONTACT_FORM_TO_EMAIL=hello@thelivablehome.com

# Analytics
NEXT_PUBLIC_GOOGLE_SEARCH_CONSOLE_VERIFICATION=
NEXT_PUBLIC_PINTEREST_TAG_ID=
